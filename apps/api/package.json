{
  "name": "@bookshelf/api",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --forceExit --runInBand",
    "test:watch": "jest --watch --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit --runInBand",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@bookshelf/shared": "*",
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/uuid": "^9.0.8",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.0"
  }
}