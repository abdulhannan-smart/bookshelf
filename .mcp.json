{
  "mcpServers": {
    "bookshelf": {
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "/Users/abdulhanan/Desktop/book shelf/bookshelf/apps/api/mcp-server.ts"
      ]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp"
      ]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
